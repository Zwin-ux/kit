"┌ help ────────────────────────────────────────────────────────────────────────┐"
"│Global                                                                        │"
"│  ?          toggle this help                                                 │"
"│  Esc        back / close help                                                │"
"│  q          quit (from the Control Room)                                     │"
"│Control Room                                                                  │"
"│  ↑↓         move selection                                                   │"
"│  Enter      open run detail (stream)                                         │"
"│  g          open gate log                                                    │"
"│  d          dispatch fan-out                                                 │"
"│  k / r      kill · retry (FAIL, or run a past run again)                     │"
"│  l          show the kit land command (PASS with changes)                    │"
"│  b / f      board · filter ALL → FAIL → RUN → DONE                           │"
"└──────────────────────────────────────────────────────────────────────────────┘"
