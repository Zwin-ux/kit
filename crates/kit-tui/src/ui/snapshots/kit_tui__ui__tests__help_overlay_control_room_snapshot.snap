"┌ help ────────────────────────────────────────────────────────────────────────┐"
"│Global                                                                        │"
"│  ?          toggle this help                                                 │"
"│  Esc        back / close help                                                │"
"│  q          quit (Control Room only; disabled while attached)                │"
"│Control Room                                                                  │"
"│  ↑↓         move selection                                                   │"
"│  Enter      open run detail (stream)                                         │"
"│  g          open gate log                                                    │"
"│  d          dispatch fan-out                                                 │"
"│  k          kill selected run                                                │"
"│  r          retry FAIL only                                                  │"
"│  b / f      board · filter ALL → FAIL → RUN → DONE                           │"
"└──────────────────────────────────────────────────────────────────────────────┘"
