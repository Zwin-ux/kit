# Dependencies
node_modules/

# Build
dist/
**/dist/
*.tsbuildinfo
**/*.tsbuildinfo
coverage/
**/coverage/

# Synced into packages/catalog before pack/publish
packages/catalog/skills/
packages/catalog/packs/
catalog/KEEP_ALIVE_REPORT.md

# Local Kit data (user home installs; project apply output may be committed intentionally)
# Ignore root-level runtime only if created during local runs
/.kit/

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
!/.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
.gstack/

# Rust
/target/

# Kit link output in the project (runtime, not source)
/.claude/*
# Kit's own repo skills are source; anything kit add writes stays ignored.
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/kit-release/
!/.claude/skills/kit-ci-triage/
/.codex/
/.grok/
